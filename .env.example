# Google OAuth credentials — create at console.cloud.google.com
# Application type: Web application
# Authorized redirect URIs: http://localhost:8501 (local), https://your-app-url (prod)
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret

# App URL used as OAuth redirect URI
# Local: http://localhost:8501
# Production: https://your-cloud-run-service-url
REDIRECT_URI=http://localhost:8501

# Whisper model size: tiny | base | small | medium | large-v3
# medium = best speed/accuracy balance; large-v3 = highest accuracy (slower, more RAM)
WHISPER_MODEL=medium

# Set to "true" in production to skip OAuth (IAP handles auth via request headers)
IAP_ENABLED=false
